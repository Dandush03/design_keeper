source "https://rubygems.org"

# Specify your gem's dependencies in design_keeper.gemspec.
gemspec

# Puma is a modern, concurrent web server for Ruby/Rack applications. [https://github.com/puma/puma]
gem "puma"

# Asset pipeline for Rails applications [https://github.com/rails/propshaft]
gem "propshaft"

# Omakase Ruby styling [https://github.com/rails/rubocop-rails-omakase/]
gem "rubocop-rails-omakase", require: false

# Start debugger with binding.b [https://github.com/ruby/debug]
# gem "debug", ">= 1.0.0"
gem "tailwindcss-rails", "~> 4.0"

# Lookbook: The view component explorer for Rails [https://lookbook.build/]
gem "lookbook", "~> 2.3"

# View component library for building reusable, testable & encapsulated view components [https://viewcomponent.org/]
gem "view_component", "~> 4.2"

# Use JavaScript with ESM import maps [https://github.com/rails/importmap-rails]
gem "importmap-rails", "~> 2.2"

# Hotwire's SPA-like page accelerator [https://turbo.hotwired.dev]
gem "turbo-rails", "~> 2.0"

# Hotwire's modest JavaScript framework [https://stimulus.hotwired.dev]
gem "stimulus-rails", "~> 1.3"
